From 7b96ece4adaa6806a647adc421b5ca8defdb545a Mon Sep 17 00:00:00 2001
From: JakeStone <208141191+JakeStone594@users.noreply.github.com>
Date: Sat, 22 Aug 2026 22:32:47 +0300
Subject: [PATCH] usb: gadget: f_hid: fix f_hidg lifetime vs cdev

Backport of upstream "usb: gadget: f_hid: fix f_hidg lifetime vs cdev"
(John Keeping, 2022-11-22), Fixes: 71adf1189469 ("USB: gadget: add HID
gadget driver").

The embedded struct cdev has no lifetime tie to the enclosing struct
f_hidg, so /dev/hidgN held open across a gadget teardown leaves the fd
pointing at freed memory. f_hidg_open() takes no reference; f_hidg_poll()
registers waiters on wait queues embedded in f_hidg; hidg_unbind() calls
cdev_del(), which does not invalidate open fds; hidg_free() then kfree()s
the struct. A select() loop surviving a re-compose calls
remove_wait_queue() on freed slab memory.

On this device that spun a ticket spinlock with IRQs masked, starved the
msm_watchdog pet, and reset the phone (RWC 569, 2026-08-21).

Pull the device up into struct f_hidg and use cdev_device_{add,del}() so
the object outlives the last open fd.

Deviations from upstream, all forced by 4.14.190 predating it:
 - hidg_release() does not free set_report_buf; the field does not exist.
 - report_desc stays kmemdup()/kfree() rather than devm_kmemdup().
 - a put_device() is added on the dev_set_name() error path (upstream
   leaks there; fixed separately in patches 2-3 of the same series).

Verified: compiles rc=0 with zero warnings; the unpatched control object's
.text is byte-identical to the shipped v5 f_hid.o, so the build
environment reproduces the real one; all undefined symbols resolve.
Flashed as v6 on 2026-08-22 and confirmed in the running kernel
(hidg_release present in kallsyms).

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011QJRDfxU9RRiUqTH9uJGZt
---
 drivers/usb/gadget/function/f_hid.c | 46 ++++++++++++++++-------------
 1 file changed, 26 insertions(+), 20 deletions(-)

diff --git a/drivers/usb/gadget/function/f_hid.c b/drivers/usb/gadget/function/f_hid.c
index 63f6e344d..5d73d6ed0 100644
--- a/drivers/usb/gadget/function/f_hid.c
+++ b/drivers/usb/gadget/function/f_hid.c
@@ -61,7 +61,7 @@ struct f_hidg {
 	wait_queue_head_t		write_queue;
 	struct usb_request		*req;
 
-	int				minor;
+	struct device			dev;
 	struct cdev			cdev;
 	struct usb_function		func;
 
@@ -74,6 +74,14 @@ static inline struct f_hidg *func_to_hidg(struct usb_function *f)
 	return container_of(f, struct f_hidg, func);
 }
 
+static void hidg_release(struct device *dev)
+{
+	struct f_hidg *hidg = container_of(dev, struct f_hidg, dev);
+
+	kfree(hidg->report_desc);
+	kfree(hidg);
+}
+
 /*-------------------------------------------------------------------------*/
 /*                           Static descriptors                            */
 
@@ -750,9 +758,7 @@ static int hidg_bind(struct usb_configuration *c, struct usb_function *f)
 	struct usb_ep		*ep;
 	struct f_hidg		*hidg = func_to_hidg(f);
 	struct usb_string	*us;
-	struct device		*device;
 	int			status;
-	dev_t			dev;
 
 	/* maybe allocate device-global string IDs, and patch descriptors */
 	us = usb_gstrings_attach(c->cdev, ct_func_strings,
@@ -826,21 +832,11 @@ static int hidg_bind(struct usb_configuration *c, struct usb_function *f)
 
 	/* create char device */
 	cdev_init(&hidg->cdev, &f_hidg_fops);
-	dev = MKDEV(major, hidg->minor);
-	status = cdev_add(&hidg->cdev, dev, 1);
+	status = cdev_device_add(&hidg->cdev, &hidg->dev);
 	if (status)
 		goto fail_free_descs;
 
-	device = device_create(hidg_class, NULL, dev, NULL,
-			       "%s%d", "hidg", hidg->minor);
-	if (IS_ERR(device)) {
-		status = PTR_ERR(device);
-		goto del;
-	}
-
 	return 0;
-del:
-	cdev_del(&hidg->cdev);
 fail_free_descs:
 	usb_free_all_descriptors(f);
 fail:
@@ -1069,8 +1065,7 @@ static void hidg_free(struct usb_function *f)
 
 	hidg = func_to_hidg(f);
 	opts = container_of(f->fi, struct f_hid_opts, func_inst);
-	kfree(hidg->report_desc);
-	kfree(hidg);
+	put_device(&hidg->dev);
 	mutex_lock(&opts->lock);
 	--opts->refcnt;
 	mutex_unlock(&opts->lock);
@@ -1080,8 +1075,7 @@ static void hidg_unbind(struct usb_configuration *c, struct usb_function *f)
 {
 	struct f_hidg *hidg = func_to_hidg(f);
 
-	device_destroy(hidg_class, MKDEV(major, hidg->minor));
-	cdev_del(&hidg->cdev);
+	cdev_device_del(&hidg->cdev, &hidg->dev);
 
 	usb_free_all_descriptors(f);
 }
@@ -1090,6 +1084,7 @@ static struct usb_function *hidg_alloc(struct usb_function_instance *fi)
 {
 	struct f_hidg *hidg;
 	struct f_hid_opts *opts;
+	int ret;
 
 	/* allocate and initialize one new instance */
 	hidg = kzalloc(sizeof(*hidg), GFP_KERNEL);
@@ -1101,7 +1096,18 @@ static struct usb_function *hidg_alloc(struct usb_function_instance *fi)
 	mutex_lock(&opts->lock);
 	++opts->refcnt;
 
-	hidg->minor = opts->minor;
+	device_initialize(&hidg->dev);
+	hidg->dev.release = hidg_release;
+	hidg->dev.class = hidg_class;
+	hidg->dev.devt = MKDEV(major, opts->minor);
+	ret = dev_set_name(&hidg->dev, "hidg%d", opts->minor);
+	if (ret) {
+		put_device(&hidg->dev);
+		--opts->refcnt;
+		mutex_unlock(&opts->lock);
+		return ERR_PTR(ret);
+	}
+
 	hidg->bInterfaceSubClass = opts->subclass;
 	hidg->bInterfaceProtocol = opts->protocol;
 	hidg->report_length = opts->report_length;
@@ -1111,7 +1117,7 @@ static struct usb_function *hidg_alloc(struct usb_function_instance *fi)
 					    opts->report_desc_length,
 					    GFP_KERNEL);
 		if (!hidg->report_desc) {
-			kfree(hidg);
+			put_device(&hidg->dev);
 			mutex_unlock(&opts->lock);
 			return ERR_PTR(-ENOMEM);
 		}
